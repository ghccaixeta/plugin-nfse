{
  "name": "preenchedor-nfse-nacional",
  "version": "1.0.0",
  "description": "Extensão Chrome e Firefox que preenche o formulário do Emissor Nacional da NFS-e",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "vite build && vite build -c vite.content.config.ts --mode ponte && vite build -c vite.content.config.ts --mode preenchedor",
    "build:firefox": "NAVEGADOR=firefox npm run build",
    "test": "vitest run && node scripts/verificar-vazamento.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "verificar:vazamento": "node scripts/verificar-vazamento.mjs",
    "firefox:lint": "web-ext lint -s dist-firefox",
    "firefox:run": "web-ext run -s dist-firefox --start-url https://www.nfse.gov.br/EmissorNacional",
    "firefox:assinar": "web-ext sign -s dist-firefox --channel=unlisted"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  }
}
